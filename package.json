      "diff": "^8.0.3"
    },
    "nanoid@<3": "^3.3.20",
    "parse-duration@<2": "^2.1.9",
    "serialize-javascript@6": "^7.1.2",
    "tmp@<0.2": "^0.2.7",
    "uuid@<11": "^11.1.1",
    "ws@7": "^7.5.13",
    "ws@8": "^8.22.0",
    "yargs-parser@2": "^5.0.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && rm -rf docs/api && typedoc --plugin typedoc-plugin-markdown --hideBreadcrumbs true && git add -A ."
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
